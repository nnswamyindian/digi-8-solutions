# Backend Environment Variables for digi8solutions.com
# Copy to server/.env in production

PORT=3001
JWT_SECRET=super_secure_random_jwt_key_digi8solutions_2026

# Database Configuration (MySQL)
DB_HOST=127.0.0.1
DB_USER=digi8_user
DB_PASSWORD=YourStrongDatabasePassword123!
DB_NAME=digi8

# Frontend Application URL (used for email verification links)
APP_URL=https://digi8solutions.com

# Admin Email for incoming lead/contact/quote notifications
ADMIN_EMAIL=digi8solutions@gmail.com

# SMTP Email Dispatcher (Gmail App Password Configuration)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=digi8solutions@gmail.com
SMTP_PASS=your_16_digit_gmail_app_password
